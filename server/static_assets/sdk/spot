#!/bin/sh
# spot — deploy static sites to the Spot platform.
# Edit this source copy, then run `just generate` to refresh the served
# sdk/spot copy and the Go-embedded server/static_assets/sdk/spot copy.
#
# Deploys go through the platform's deploy API (the same endpoint the
# apex web deployer uses), so the only configuration is where the
# platform lives. Via environment (or $XDG_CONFIG_HOME/spot/env,
# default ~/.config/spot/env, sourced if present):
#   SPOT_URL   apex URL of the Spot deployment
#              (default http://spot.localhost:8080)
set -eu

# Read SPOT_URL from the config without executing the file: parse it as
# KEY=VALUE and accept only the SPOT_URL key, so a hostile value cannot
# run as shell. An env-provided SPOT_URL takes precedence.
spot_config="${XDG_CONFIG_HOME:-$HOME/.config}/spot/env"
if [ -z "${SPOT_URL:-}" ] && [ -f "$spot_config" ]; then
    while IFS='=' read -r key value; do
        [ "$key" = SPOT_URL ] && SPOT_URL=$value
    done < "$spot_config"
fi

SPOT_URL=${SPOT_URL:-http://spot.localhost:8080}
SPOT_URL=${SPOT_URL%/}
SPOT_SCHEME=${SPOT_URL%%://*}
SPOT_HOSTPORT=${SPOT_URL#*://}
SPOT_DOMAIN=${SPOT_HOSTPORT%%:*}

# Local HTTPS dev may use a private CA; localhost is trusted implicitly.
case $SPOT_DOMAIN in
    localhost|*.localhost) SPOT_CURL_OPTS=-k ;;
    *) SPOT_CURL_OPTS= ;;
esac

banner() {
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        esc=$(printf '\033')
        pink="${esc}[38;5;205m"
        violet="${esc}[38;5;99m"
        mint="${esc}[38;5;48m"
        reset="${esc}[0m"
        printf '%s\n' \
            "${pink}"'   _____             __'"${reset}" \
            "${pink}"'  / ___/____  ____  / /_'"${reset}" \
            "${violet}"'  \__ \/ __ \/ __ \/ __/'"${reset}" \
            "${violet}"' ___/ / /_/ / /_/ / /_'"${reset}" \
            "${mint}"'/____/ .___/\____/\__/'"${reset}" \
            "${mint}"'    /_/'"${reset}" \
            "${violet}"'  Drop a folder, get a spot.'"${reset}" \
            ""
    else
        cat <<'EOF'
   _____             __
  / ___/____  ____  / /_
  \__ \/ __ \/ __ \/ __/
 ___/ / /_/ / /_/ / /_
/____/ .___/\____/\__/
    /_/
  Drop a folder, get a spot.

EOF
    fi
}

usage() {
    banner
    cat <<'EOF'
usage: spot <command>

commands:
  deploy [name] [path]  sync a directory or index.html (default .) to
                        the site <name> (default: current directory name)
  show build [json] [out]
                        render a card/block show.json into a static site
  show deploy <name> [json]
                        render show.json and deploy it to <name>
  init [options]        write the Spot agent skill for Claude, Codex, or Pi
  update                replace this CLI with the latest from SPOT_URL

init options:
  --agent <list>        comma-separated agents: claude,codex,pi
  --all-agents          install for every supported agent
  --scope <scope>       project or user
  --yes, -y             accept detected defaults without prompting
  --force               overwrite existing skill files
  --dry-run             print target files without writing
EOF
    exit 1
}

deploy() {
    name=${1:-$(basename "$PWD")}
    src=${2:-.}
    preserve_access=${3:-}
    if [ "$#" -eq 1 ] && [ -f "$1" ] && [ "$(basename "$1")" = "index.html" ]; then
        name=$(basename "$PWD")
        src=$1
    fi
    case $name in
        *[!a-z0-9-]*|'')
            echo "error: site name '$name' must match [a-z0-9-]+" >&2
            exit 1
            ;;
    esac
    if [ -f "$src" ]; then
        file=$(basename "$src")
        dir=$(dirname "$src")
        if [ "$file" != "index.html" ]; then
            echo "error: single-file deploys must be named index.html" >&2
            exit 1
        fi
    else
        dir=$src
        if [ ! -e "$dir/index.html" ]; then
            echo "error: $dir/index.html not found — a site needs at least an index.html" >&2
            exit 1
        fi
    fi
    echo "deploying $src -> $name.$SPOT_DOMAIN"

    # One -F part per file, the filename carrying the site-relative path
    # — the shape /api/deploy expects. The server syncs: files absent
    # from the upload are removed from the live site. Dot directories
    # (.git and friends) stay home; the server drops them anyway.
    #
    # Quote the path and filename= values so curl does not treat ';' ','
    # or '@' in a filename as -F metacharacters.
    set -- -F "site=$name"
    if [ "$preserve_access" = "--preserve-access" ]; then
        set -- "$@" -F "preserve_access=true"
    fi
    if [ -f "$src" ]; then
        set -- "$@" -F "files=@\"$file\";filename=\"index.html\""
    else
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            f=${f#./}
            set -- "$@" -F "files=@\"$f\";filename=\"$f\""
        done <<EOF
$(cd "$dir" && find . -name '.?*' -prune -o -type f -print)
EOF
    fi

    # Capture curl's exit without tripping set -e, so a network/HTTP
    # failure reaches the friendly message below instead of aborting.
    if ! out=$(cd "$dir" && curl -sS $SPOT_CURL_OPTS -w '\n%{http_code}' \
        "$@" "$SPOT_URL/api/deploy"); then
        echo "error: could not reach $SPOT_URL/api/deploy" >&2
        exit 1
    fi
    status=$(printf '%s' "$out" | tail -n 1)
    body=$(printf '%s' "$out" | sed '$d')
    if [ "$status" != "200" ]; then
        echo "error: deploy failed (HTTP $status): $body" >&2
        exit 1
    fi
    echo "live: $SPOT_SCHEME://$name.$SPOT_HOSTPORT/"
}

show_usage() {
    cat <<'EOF'
usage:
  spot show build [show.json] [out-dir]
  spot show deploy <site-name> [show.json]

show.json shape:
{
  "title": "Auth refactor",
  "description": "Optional one-line summary",
  "cards": [{
    "title": "Current flow",
    "blocks": [
      { "kind": "markdown", "body": "## Notes\n- One\n- Two" },
      { "kind": "mermaid", "body": "graph TD\nA-->B" },
      { "kind": "diff", "body": "--- a\n+++ b\n@@ ..." },
      { "kind": "terminal", "body": "go test ./...\nok" },
      { "kind": "code", "language": "js", "body": "console.log('hi')" },
      { "kind": "json", "value": { "ok": true } },
      { "kind": "image", "src": "https://...", "caption": "Optional" },
      { "kind": "html", "body": "<button>Sandboxed</button>" }
    ]
  }]
}
EOF
    exit 1
}

show_build() {
    spec=${1:-show.json}
    out=${2:-spot-show-out}
    [ -f "$spec" ] || { echo "error: $spec not found" >&2; exit 1; }
    case $out in
        ''|/|.) echo "error: refusing to write show output to '$out'" >&2; exit 1 ;;
    esac
    spec_dir=$(cd "$(dirname "$spec")" && pwd -P) || exit 1
    spec_abs=$spec_dir/$(basename "$spec")
    if [ -e "$out" ]; then
        if [ -d "$out" ]; then
            out_abs=$(cd "$out" && pwd -P) || exit 1
            case $spec_abs in
                "$out_abs"/*) echo "error: refusing to write show output over source '$spec'" >&2; exit 1 ;;
            esac
        else
            out_dir=$(cd "$(dirname "$out")" && pwd -P) || exit 1
            out_abs=$out_dir/$(basename "$out")
            [ "$out_abs" != "$spec_abs" ] || { echo "error: refusing to write show output over source '$spec'" >&2; exit 1; }
        fi
    fi
    rm -rf "$out"
    mkdir -p "$out"
    cp "$spec" "$out/show.json"
    cat > "$out/_spot.json" <<'EOF'
{"title":"Spot Show","description":"A card/block visual report rendered by Spot.","tags":["spot-show","agent","dashboard","tools"]}
EOF
    cat > "$out/index.html" <<'EOF'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Spot Show</title>
  <style>
    :root { color-scheme: dark; --bg:#07070a; --panel:rgba(18,18,24,.78); --panel2:rgba(255,255,255,.055); --line:rgba(255,255,255,.12); --text:#f7f7fb; --muted:rgba(247,247,251,.68); --dim:rgba(247,247,251,.44); --accent:#a78bfa; --accent2:#22d3ee; --good:#86efac; --bad:#fca5a5; --warn:#fcd34d; }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; color:var(--text); font:15px/1.55 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: radial-gradient(circle at 10% 0%, rgba(124,58,237,.45), transparent 34rem), radial-gradient(circle at 92% 12%, rgba(34,211,238,.28), transparent 30rem), radial-gradient(circle at 50% 100%, rgba(244,63,94,.18), transparent 32rem), var(--bg); }
    .shell { width:min(1180px, calc(100vw - 32px)); margin:0 auto; padding:34px 0 56px; }
    header { display:grid; grid-template-columns:1fr auto; gap:18px; align-items:end; margin-bottom:24px; }
    .eyebrow { display:inline-flex; gap:8px; align-items:center; width:max-content; color:#d8b4fe; background:rgba(167,139,250,.12); border:1px solid rgba(167,139,250,.22); border-radius:999px; padding:6px 10px; font-weight:750; font-size:12px; letter-spacing:.05em; text-transform:uppercase; }
    .dot { width:8px; height:8px; border-radius:999px; background:var(--good); box-shadow:0 0 18px var(--good); }
    h1 { margin:16px 0 8px; max-width:920px; font-size:clamp(38px, 7vw, 84px); line-height:.9; letter-spacing:-.075em; }
    .desc { margin:0; max-width:760px; color:var(--muted); font-size:19px; }
    .meta { color:var(--dim); font-size:13px; text-align:right; }
    .grid { display:grid; grid-template-columns: repeat(12, 1fr); gap:18px; }
    .card { grid-column: span 12; background:linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.035)); border:1px solid var(--line); border-radius:26px; padding:22px; box-shadow:0 24px 80px rgba(0,0,0,.32); backdrop-filter: blur(22px); }
    .card.compact { grid-column: span 6; }
    .card h2 { margin:0 0 4px; font-size:26px; line-height:1.05; letter-spacing:-.04em; }
    .card .summary { margin:0 0 18px; color:var(--muted); }
    .block { margin-top:14px; overflow:hidden; border:1px solid var(--line); border-radius:18px; background:var(--panel2); }
    .block-head { display:flex; justify-content:space-between; gap:12px; align-items:center; padding:10px 13px; border-bottom:1px solid var(--line); color:var(--muted); font-size:12px; font-weight:760; letter-spacing:.06em; text-transform:uppercase; }
    .block-body { padding:16px; }
    .markdown { color:var(--text); }
    .markdown h1,.markdown h2,.markdown h3 { margin:1em 0 .35em; letter-spacing:-.035em; line-height:1.05; }
    .markdown h1:first-child,.markdown h2:first-child,.markdown h3:first-child,.markdown p:first-child { margin-top:0; }
    .markdown p { margin:.65em 0; color:rgba(247,247,251,.82); }
    .markdown ul,.markdown ol { margin:.6em 0 .6em 1.3em; padding:0; color:rgba(247,247,251,.82); }
    .markdown code { color:#f0abfc; background:rgba(240,171,252,.10); padding:.12em .32em; border-radius:6px; }
    pre { margin:0; overflow:auto; white-space:pre-wrap; word-break:break-word; color:#e5e7eb; font:13px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .code pre, .json pre { white-space:pre; }
    .terminal { background:#050507; border-color:rgba(255,255,255,.16); }
    .terminal .block-head:before { content:""; width:34px; height:10px; background:radial-gradient(circle at 5px 5px,#fb7185 4px,transparent 5px), radial-gradient(circle at 17px 5px,#fbbf24 4px,transparent 5px), radial-gradient(circle at 29px 5px,#34d399 4px,transparent 5px); }
    .diff-line { display:block; min-height:1.5em; padding:0 4px; border-left:3px solid transparent; }
    .diff-add { color:#bbf7d0; background:rgba(34,197,94,.10); border-left-color:#22c55e; }
    .diff-del { color:#fecaca; background:rgba(239,68,68,.10); border-left-color:#ef4444; }
    .diff-hunk { color:#fde68a; background:rgba(245,158,11,.10); border-left-color:#f59e0b; }
    .diff-file { color:#bae6fd; background:rgba(14,165,233,.10); border-left-color:#0ea5e9; }
    .image img { display:block; max-width:100%; border-radius:14px; margin:0 auto; }
    .caption { margin:10px 0 0; color:var(--muted); font-size:13px; text-align:center; }
    iframe.html-frame { width:100%; border:0; border-radius:14px; background:white; min-height:220px; }
    details.json-node { margin-left:1rem; }
    details.json-node summary { cursor:pointer; color:#bfdbfe; }
    .json-key { color:#f0abfc; }
    .json-primitive { color:#a7f3d0; margin-left:1rem; }
    .empty, .error { border:1px solid var(--line); border-radius:18px; padding:18px; background:rgba(255,255,255,.055); color:var(--muted); }
    .error { color:var(--bad); }
    @media (max-width: 820px) { header { grid-template-columns:1fr; } .meta { text-align:left; } .card.compact { grid-column: span 12; } }
  </style>
</head>
<body>
  <div class="shell">
    <header>
      <div>
        <div class="eyebrow"><span class="dot"></span> Spot Show</div>
        <h1 id="title">Loading…</h1>
        <p class="desc" id="description"></p>
      </div>
      <div class="meta" id="meta"></div>
    </header>
    <main class="grid" id="cards"></main>
  </div>
  <script>
    const $ = (tag, cls, text) => { const el = document.createElement(tag); if (cls) el.className = cls; if (text !== undefined) el.textContent = text; return el; };
    const text = (v) => v == null ? '' : String(v);
    const bodyOf = (block) => text(block.body ?? block.text ?? block.content ?? '');

    function blockShell(kind, title) {
      const block = $('section', 'block ' + kind);
      const head = $('div', 'block-head');
      head.append($('span', '', title || kind));
      block.append(head, $('div', 'block-body'));
      return block;
    }

    function renderMarkdown(src) {
      const root = $('div', 'markdown');
      const lines = src.split(/\r?\n/);
      let i = 0;
      let para = [];
      const flushPara = () => { if (!para.length) return; root.append(renderInlineParagraph(para.join(' '))); para = []; };
      while (i < lines.length) {
        const line = lines[i];
        if (line.startsWith('```')) {
          flushPara();
          const lang = line.slice(3).trim();
          i++;
          const code = [];
          while (i < lines.length && !lines[i].startsWith('```')) code.push(lines[i++]);
          if (i < lines.length) i++;
          const pre = $('pre'); const codeEl = $('code'); if (lang) codeEl.dataset.lang = lang; codeEl.textContent = code.join('\n'); pre.append(codeEl); root.append(pre); continue;
        }
        const heading = /^(#{1,3})\s+(.*)$/.exec(line);
        if (heading) { flushPara(); root.append($('h' + heading[1].length, '', heading[2])); i++; continue; }
        if (/^\s*[-*]\s+/.test(line)) {
          flushPara(); const ul = $('ul');
          while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) { ul.append($('li', '', lines[i].replace(/^\s*[-*]\s+/, ''))); i++; }
          root.append(ul); continue;
        }
        if (/^\s*\d+\.\s+/.test(line)) {
          flushPara(); const ol = $('ol');
          while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) { ol.append($('li', '', lines[i].replace(/^\s*\d+\.\s+/, ''))); i++; }
          root.append(ol); continue;
        }
        if (line.trim() === '') { flushPara(); i++; continue; }
        para.push(line.trim()); i++;
      }
      flushPara();
      return root;
    }

    function renderInlineParagraph(src) {
      const p = $('p');
      const parts = src.split(/(`[^`]+`)/g);
      for (const part of parts) {
        if (part.startsWith('`') && part.endsWith('`')) p.append($('code', '', part.slice(1, -1)));
        else p.append(document.createTextNode(part));
      }
      return p;
    }

    function renderDiff(src) {
      const pre = $('pre');
      for (const line of src.split(/\r?\n/)) {
        const span = $('span', 'diff-line');
        if (line.startsWith('+') && !line.startsWith('+++')) span.classList.add('diff-add');
        else if (line.startsWith('-') && !line.startsWith('---')) span.classList.add('diff-del');
        else if (line.startsWith('@@')) span.classList.add('diff-hunk');
        else if (/^(diff --git|--- |\+\+\+ )/.test(line)) span.classList.add('diff-file');
        span.textContent = line || ' ';
        pre.append(span);
      }
      return pre;
    }

    function renderJSON(value) {
      const root = $('div');
      const render = (v, key) => {
        if (v && typeof v === 'object') {
          const d = $('details', 'json-node'); d.open = true;
          const label = key == null ? (Array.isArray(v) ? 'array' : 'object') : key;
          d.append($('summary', '', `${label} ${Array.isArray(v) ? '[' + v.length + ']' : '{' + Object.keys(v).length + '}'}`));
          for (const [k, child] of Object.entries(v)) d.append(render(child, k));
          return d;
        }
        const row = $('div', 'json-primitive');
        if (key != null) row.append($('span', 'json-key', key + ': '));
        row.append(document.createTextNode(JSON.stringify(v)));
        return row;
      };
      root.append(render(value));
      return root;
    }

    let mermaidPromise;
    function loadMermaid() {
      if (window.mermaid) return Promise.resolve(window.mermaid);
      if (mermaidPromise) return mermaidPromise;
      mermaidPromise = new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
        s.onload = () => { window.mermaid.initialize({ startOnLoad:false, theme:'dark' }); resolve(window.mermaid); };
        s.onerror = reject;
        document.head.append(s);
      });
      return mermaidPromise;
    }

    function renderBlock(block, index) {
      const kind = text(block.kind || block.type || 'markdown').toLowerCase();
      const shell = blockShell(kind, block.title || kind);
      const body = shell.querySelector('.block-body');
      if (kind === 'markdown') body.append(renderMarkdown(bodyOf(block)));
      else if (kind === 'diff') body.append(renderDiff(bodyOf(block)));
      else if (kind === 'terminal' || kind === 'code') { const pre = $('pre'); pre.textContent = bodyOf(block); body.append(pre); }
      else if (kind === 'json') body.append(renderJSON(block.value ?? block.body ?? block.data ?? null));
      else if (kind === 'image') { const img = $('img'); img.src = text(block.src || block.url); img.alt = text(block.alt || block.caption || ''); body.append(img); if (block.caption) body.append($('p', 'caption', block.caption)); }
      else if (kind === 'html') { const frame = $('iframe', 'html-frame'); frame.sandbox = 'allow-scripts allow-forms allow-popups'; frame.srcdoc = bodyOf(block); frame.addEventListener('load', () => { try { frame.style.height = Math.max(220, frame.contentDocument.body.scrollHeight + 24) + 'px'; } catch {} }); body.append(frame); }
      else if (kind === 'mermaid') { const target = $('div'); target.textContent = bodyOf(block); body.append(target); loadMermaid().then(async (m) => { const id = 'm' + Date.now() + '-' + index; const out = await m.render(id, bodyOf(block)); target.innerHTML = out.svg; }).catch(() => { target.textContent = bodyOf(block); }); }
      else body.append(renderMarkdown(bodyOf(block)));
      return shell;
    }

    async function main() {
      const res = await fetch('show.json', { cache: 'no-store' });
      if (!res.ok) throw new Error('could not load show.json');
      const show = await res.json();
      document.title = show.title || 'Spot Show';
      document.getElementById('title').textContent = show.title || 'Untitled show';
      document.getElementById('description').textContent = show.description || show.summary || '';
      document.getElementById('meta').textContent = show.updated_at || new Date().toLocaleString();
      const cards = document.getElementById('cards'); cards.textContent = '';
      const list = Array.isArray(show.cards) ? show.cards : [];
      if (!list.length) { cards.append($('div', 'empty', 'No cards in show.json')); return; }
      list.forEach((card, cardIndex) => {
        const el = $('article', 'card' + (card.compact ? ' compact' : ''));
        if (card.title) el.append($('h2', '', card.title));
        if (card.summary || card.description) el.append($('p', 'summary', card.summary || card.description));
        const blocks = Array.isArray(card.blocks) ? card.blocks : [];
        blocks.forEach((block, blockIndex) => el.append(renderBlock(block, cardIndex + '-' + blockIndex)));
        cards.append(el);
      });
    }
    main().catch((err) => { document.getElementById('title').textContent = 'Could not render show'; document.getElementById('cards').append($('div', 'error', err.message || String(err))); });
  </script>
  <script src="/spot-live.js" defer data-cache-bust="true"></script>
</body>
</html>
EOF
    echo "built show site: $out"
}

show_deploy() {
    [ $# -ge 1 ] || show_usage
    site=$1
    spec=${2:-show.json}
    case $site in
        *[!a-z0-9-]*|'') echo "error: site name '$site' must match [a-z0-9-]+" >&2; exit 1 ;;
    esac
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/spot-show.XXXXXX")
    cleanup_show() { rm -rf "$tmp"; }
    trap cleanup_show EXIT INT TERM
    show_build "$spec" "$tmp"
    deploy "$site" "$tmp" --preserve-access
}

show() {
    sub=${1:-help}
    [ $# -gt 0 ] && shift
    case $sub in
        build)  show_build "$@" ;;
        deploy) show_deploy "$@" ;;
        *)      show_usage ;;
    esac
}

current_executable() {
    case $0 in
        */*) path=$0 ;;
        *)
            path=$(command -v "$0" 2>/dev/null || true)
            ;;
    esac
    [ -n "$path" ] || { echo "error: could not resolve spot executable" >&2; exit 1; }
    case $path in
        /*) ;;
        *) path=$(pwd -P)/$path ;;
    esac

    dir=$(dirname "$path")
    base=$(basename "$path")
    if ! dir=$(cd "$dir" && pwd -P); then
        echo "error: could not resolve spot executable directory" >&2
        exit 1
    fi
    printf '%s/%s\n' "$dir" "$base"
}

update_cli() {
    while [ $# -gt 0 ]; do
        case $1 in
            --help|-h)
                cat <<EOF
usage: spot update

Downloads $SPOT_URL/spot and replaces this executable if it changed.
EOF
                exit 0
                ;;
            *)
                echo "error: unknown update option '$1'" >&2
                exit 1
                ;;
        esac
    done

    target=$(current_executable)
    target_dir=${target%/*}
    target_base=${target##*/}
    tmp=$(mktemp "${TMPDIR:-/tmp}/spot-update.XXXXXX")
    staged="$target_dir/.$target_base.update.$$"

    cleanup_update() {
        rm -f "$tmp" "$staged"
    }
    trap cleanup_update EXIT INT TERM

    echo "checking $SPOT_URL/spot"
    if ! curl -fsSL $SPOT_CURL_OPTS "$SPOT_URL/spot" -o "$tmp"; then
        echo "error: could not download $SPOT_URL/spot" >&2
        exit 1
    fi
    if ! sh -n "$tmp"; then
        echo "error: downloaded CLI is not a valid shell script" >&2
        exit 1
    fi
    if cmp -s "$tmp" "$target"; then
        echo "spot is already up to date: $target"
        exit 0
    fi

    if ! cp "$tmp" "$staged"; then
        echo "error: could not stage update in $target_dir" >&2
        exit 1
    fi
    chmod 755 "$staged"
    if ! mv "$staged" "$target"; then
        echo "error: could not replace $target" >&2
        exit 1
    fi
    echo "updated spot -> $target"
}

agent_label() {
    case $1 in
        claude) echo "Claude Code" ;;
        codex)  echo "Codex" ;;
        pi)     echo "Pi" ;;
        *)      echo "$1" ;;
    esac
}

validate_agent() {
    case $1 in
        claude|codex|pi) ;;
        *)
            echo "error: unsupported agent '$1' (want claude, codex, or pi)" >&2
            exit 1
            ;;
    esac
}

validate_scope() {
    case $1 in
        project|user) ;;
        *)
            echo "error: unsupported scope '$1' (want project or user)" >&2
            exit 1
            ;;
    esac
}

project_skill_path() {
    case $1 in
        claude) echo ".claude/skills/spot/SKILL.md" ;;
        codex)  echo ".codex/skills/spot/SKILL.md" ;;
        pi)     echo ".pi/skills/spot/SKILL.md" ;;
    esac
}

user_skill_path() {
    case $1 in
        claude) echo "${CLAUDE_HOME:-$HOME/.claude}/skills/spot/SKILL.md" ;;
        codex)  echo "${CODEX_HOME:-$HOME/.codex}/skills/spot/SKILL.md" ;;
        pi)     echo "${PI_HOME:-$HOME/.pi}/skills/spot/SKILL.md" ;;
    esac
}

skill_path() {
    case $2 in
        project) project_skill_path "$1" ;;
        user)    user_skill_path "$1" ;;
    esac
}

agent_detect() {
    case $1 in
        claude)
            [ -d .claude ] && { echo "project .claude/ exists"; return 0; }
            [ -d "${CLAUDE_HOME:-$HOME/.claude}" ] && { echo "user ~/.claude/ exists"; return 0; }
            command -v claude >/dev/null 2>&1 && { echo "claude command found"; return 0; }
            ;;
        codex)
            [ -d .codex ] && { echo "project .codex/ exists"; return 0; }
            [ -d "${CODEX_HOME:-$HOME/.codex}" ] && { echo "user ~/.codex/ exists"; return 0; }
            command -v codex >/dev/null 2>&1 && { echo "codex command found"; return 0; }
            ;;
        pi)
            [ -d .pi ] && { echo "project .pi/ exists"; return 0; }
            [ -d "${PI_HOME:-$HOME/.pi}" ] && { echo "user ~/.pi/ exists"; return 0; }
            command -v pi >/dev/null 2>&1 && { echo "pi command found"; return 0; }
            ;;
    esac
    echo "not detected"
    return 1
}

is_project_dir() {
    [ -d .git ] && return 0
    [ -d .claude ] && return 0
    [ -d .codex ] && return 0
    [ -d .pi ] && return 0
    [ -f package.json ] && return 0
    [ -f go.mod ] && return 0
    [ -f pyproject.toml ] && return 0
    [ -f index.html ] && return 0
    if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

agent_in_list() {
    needle=$1
    for item in $selected_agents; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

add_agent() {
    validate_agent "$1"
    if ! agent_in_list "$1"; then
        selected_agents="${selected_agents}${selected_agents:+ }$1"
    fi
}

add_agent_list() {
    for agent in $(printf '%s' "$1" | tr ',' ' '); do
        [ -n "$agent" ] && add_agent "$agent"
    done
}

default_agents() {
    selected_agents=
    for agent in claude codex pi; do
        if agent_detect "$agent" >/dev/null 2>&1; then
            add_agent "$agent"
        fi
    done
    [ -n "$selected_agents" ] || add_agent claude
}

print_agent_picker() {
    echo "Which agents should get the Spot skill?"
    for agent in claude codex pi; do
        mark=" "
        agent_in_list "$agent" && mark="x"
        if reason=$(agent_detect "$agent"); then
            status="detected: $reason"
        else
            status="$reason"
        fi
        printf '  [%s] %s  %s\n' "$mark" "$(agent_label "$agent")" "$status"
    done
}

prompt_scope() {
    default_scope=project
    is_project_dir || default_scope=user

    echo "Where should Spot instructions be installed?"
    if [ "$default_scope" = project ]; then
        echo "  1) Project skill (recommended): ./<agent>/skills/spot/SKILL.md"
        echo "  2) User skill: ~/.<agent>/skills/spot/SKILL.md"
    else
        echo "  1) User skill (recommended): ~/.<agent>/skills/spot/SKILL.md"
        echo "  2) Project skill: ./<agent>/skills/spot/SKILL.md"
    fi
    printf 'Scope [%s]: ' "$default_scope"
    IFS= read -r answer || answer=
    case ${answer:-$default_scope} in
        1)
            if [ "$default_scope" = project ]; then init_scope=project; else init_scope=user; fi
            ;;
        2)
            if [ "$default_scope" = project ]; then init_scope=user; else init_scope=project; fi
            ;;
        p|project) init_scope=project ;;
        u|user)    init_scope=user ;;
        *)
            echo "error: unsupported scope '$answer' (want project or user)" >&2
            exit 1
            ;;
    esac
}

prompt_agents() {
    default_agents
    print_agent_picker
    printf 'Agents [%s]: ' "$(printf '%s' "$selected_agents" | tr ' ' ',')"
    IFS= read -r answer || answer=
    if [ -n "$answer" ]; then
        selected_agents=
        add_agent_list "$answer"
    fi
}

confirm_write() {
    echo "Install Spot skill for:"
    echo "  scope: $init_scope"
    echo "  agents: $(printf '%s' "$selected_agents" | tr ' ' ',')"
    for agent in $selected_agents; do
        echo "  - $(skill_path "$agent" "$init_scope")"
    done
    printf 'Write files? [Y/n]: '
    IFS= read -r answer || answer=
    case ${answer:-y} in
        y|Y|yes|YES) ;;
        *) echo "cancelled"; exit 0 ;;
    esac
}

render_skill() {
    cat <<EOF
---
name: spot
description: Build and deploy sites and Spot Show card/block visual reports on Spot, the internal hosting platform. Use when creating or updating a Spot site, showing plans, architecture diagrams, diffs, terminal output, JSON, screenshots, or when a site needs identity, database, realtime, file uploads, text AI, AI image generation, or Slack notifications.
---

# Spot

Spot hosts static sites for everyone on the internal network. A site is a
folder with an index.html, or a single index.html file. Deploy with
\`spot deploy <name>\` from the site directory or
\`spot deploy <name> index.html\`; it is then live at
$SPOT_SCHEME://<name>.$SPOT_HOSTPORT/.

There is no build step and no framework. Plain HTML/CSS/JS works best.

## Spot Show: card/block visual reports

When you need to show a plan, architecture sketch, diff review, command
output, or other agent work-in-progress, prefer a Spot Show over a one-off
custom page. Before authoring one, fetch the current schema from this Spot
server:

\`\`\`sh
curl -fsSL $SPOT_SCHEME://$SPOT_HOSTPORT/spot-show-schema.md
\`\`\`

Then write a \`show.json\` with cards and blocks and deploy it:

\`\`\`sh
spot show deploy <site-name> show.json
\`\`\`

Use the same \`<site-name>\` while iterating; open browsers refresh because
the generated page includes \`/spot-live.js\`. To inspect the generated static
site without deploying:

\`\`\`sh
spot show build show.json spot-show-out
\`\`\`

Minimal shape:

\`\`\`json
{
  "title": "Auth refactor review",
  "description": "What changed and why.",
  "cards": [{
    "title": "Proposed flow",
    "blocks": [
      { "kind": "markdown", "body": "## Summary\\n- Token exchange moves server-side" },
      { "kind": "mermaid", "body": "graph TD\\nA[Login] --> B[Server]" },
      { "kind": "diff", "body": "--- old\\n+++ new\\n@@ ..." },
      { "kind": "terminal", "body": "go test ./...\\nok" },
      { "kind": "code", "language": "go", "body": "func main() {}" },
      { "kind": "json", "value": { "status": "ok" } },
      { "kind": "image", "src": "https://...", "caption": "Screenshot" },
      { "kind": "html", "body": "<button>Sandboxed mini demo</button>" }
    ]
  }]
}
\`\`\`

Keep shows concise and redeploy after each meaningful change so the user can
review in the browser. Prefer updating the same \`show.json\` and same site
name over creating new sites.

### Spot Show schema reference

Top-level fields:

- \`title\` string — required; names the board.
- \`description\` string — optional one-line context.
- \`updated_at\` string — optional; shown in the header.
- \`cards\` array — required; ordered cards.

Card fields:

- \`title\` string — card heading.
- \`summary\` or \`description\` string — short card intro.
- \`compact\` boolean — optional; renders as a half-width card on wide screens.
- \`blocks\` array — ordered block list.

Block fields common to all kinds:

- \`kind\` string — one of the kinds below.
- \`title\` string — optional label in the block header.
- Text blocks accept \`body\`, \`text\`, or \`content\`; prefer \`body\`.

Supported block kinds:

| kind | Use for | Fields |
| --- | --- | --- |
| \`markdown\` | prose, plans, bullets, headings, fenced code | \`body\` |
| \`mermaid\` | flowcharts, sequence diagrams, state diagrams | \`body\` with Mermaid source |
| \`diff\` | patches/code review | \`body\` with unified/git diff text |
| \`terminal\` | test output, logs, commands | \`body\` with plain terminal text |
| \`code\` | focused snippets | \`body\`, optional \`language\` |
| \`json\` | structured data/config/API output | \`value\` for parsed JSON; \`body\` also works |
| \`image\` | screenshots or generated images | \`src\` or \`url\`, optional \`alt\`, \`caption\` |
| \`html\` | small interactive/custom demos | \`body\` as a complete iframe document fragment |

Authoring guidance:

- Use \`markdown\` + \`mermaid\` for design explanations.
- Use \`diff\` + \`terminal\` for implementation/review checkpoints.
- Use \`json\` when the shape of data matters more than prose.
- Use \`html\` sparingly for small demos; it is sandboxed in an iframe.
- Do not embed secrets: Spot source can be downloadable by authorized viewers.

## Gallery preview

The public gallery shows a thumbnail for each site. Ship a screenshot of
the finished page named \`_screenshot.jpg\` (\`.png\` or \`.webp\` also
work) at the site root and the gallery uses it; without one the site
falls back to a generated placeholder. After building a site, capture it
at a desktop size (about 1280x800) and include the image in the deploy.

## Gallery metadata

For public sites, ship \`_spot.json\` at the site root so the gallery can
show useful copy and filters. Write it by hand as part of the site, next
to \`index.html\`:

\`\`\`json
{
  "title": "Sketch Pad",
  "description": "Draw quick ideas in the browser.",
  "tags": ["creative", "drawing", "tool"]
}
\`\`\`

Use a short human title, one sentence of description, and 3-5 tags. Tags
should be lowercase, generic, and useful for filtering: \`ai\`, \`games\`,
\`tools\`, \`dashboard\`, \`education\`, \`personal\`, \`music\`,
\`creative\`, \`work\`, \`finance\`, etc. Use hyphens for multi-word tags
and avoid names, emails, team secrets, or overly specific project labels.

If \`tags\` is omitted and the deployment has AI configured, Spot may
suggest tags for public sites from the title, description, headings, and
filenames. Prefer explicit tags when you know the intent. Restricted
sites are not auto-tagged; still avoid putting private information in
\`_spot.json\` because permitted visitors can download deployed source.

## Source downloads

Every site exposes its deployed source as a ZIP at \`/api/download\` on
the site origin, for example
\`$SPOT_SCHEME://<name>.$SPOT_HOSTPORT/api/download\`. When you build a
site, assume other authorized visitors can download the exact deployed
HTML/CSS/JS and assets from there.

If the site should be viewable but not downloadable, ship
\`{ "download": false }\` in \`_access.json\`. This does not restrict
normal page access unless an \`allow\` list is also present.

## Backend SDK

Load the SDK with \`<script src="/spot.js"></script>\`. Everything is
same-origin and zero-config — no API keys, no auth code.

### Identity

\`\`\`js
const me = await spot.me();
// { email, name, peer_name, peer_ip, groups, ai_allowed, slack_allowed } — from the mesh.
// ai_allowed and slack_allowed report whether this visitor may call spot.ai or
// spot.slack on this site, so a page can show/hide features without provoking a 403.
\`\`\`

### Database (schemaless document collections, private to this site)

\`\`\`js
const posts = spot.db.collection('posts');
const doc = await posts.create({ title: 'Hello' }); // { id, owner, data, created_at, updated_at }
const docs = await posts.list({ limit: 100 });      // newest first
const next = await posts.list({ limit: 100, after: docs.at(-1)?.id });
const mine = await posts.list({ mine: true });      // only docs this visitor created
await posts.get(doc.id);
await posts.update(doc.id, { title: 'Bye' });       // replaces data
await posts.updateMine(doc.id, { title: 'Mine' });  // only if this visitor owns it
await posts.delete(doc.id);
await posts.deleteMine(doc.id);

// Filter, sort, count, and batch reads. where ops: eq ne gt gte lt lte in.
const open = await posts.list({ where: { status: 'open' }, sort: 'priority', order: 'desc' });
const hot = await posts.list({ where: { score: { gte: 10 } } });
const n = await posts.count({ where: { status: 'open' } });
const some = await posts.getMany([id1, id2]);       // missing ids omitted
for await (const doc of posts.iterate({ pageSize: 100 })) { /* every doc, paged */ }

// Atomic counter — no read-modify-write, safe under concurrency:
await posts.increment(doc.id, 'views');             // +1
await posts.increment(doc.id, 'score', 5);
\`\`\`

Collection names must match [a-z0-9_-]{1,64}. Documents are JSON objects
up to 1 MB. Each document records an \`owner\` — the mesh identity that
created it — so multiple visitors can keep private data in one shared
site; \`list({ mine: true })\` returns only the caller's documents. Writes
are not restricted to the owner by default, so use \`updateMine\`,
\`deleteMine\`, \`incrementMine\`, or \`{ mine: true }\` on mutations when
only the creator should be able to change a document.

\`where\` and \`sort\` address top-level JSON fields. \`update\` replaces a
document; \`increment\` adds to a numeric field in one atomic step, so it is
the right tool for vote/view/like counters. The \`after\` cursor applies
only to the default newest-first order, not to a custom \`sort\`.

Collections are private to this site, except collections named
\`shared-*\`: those are global and readable/writable by every Spot site.
Use the prefix deliberately — for cross-site libraries, leaderboards,
and the like.

### Realtime

Subscribe to a collection to receive every visitor's changes live —
this is how to build collaborative and multiplayer sites:

\`\`\`js
const unsubscribe = posts.subscribe({
  onCreate: (doc) => { /* doc = { id, owner, data, created_at, updated_at } */ },
  onUpdate: (doc) => {},
  onDelete: (id) => {},
}, { replay: true }); // replay emits the current documents as onCreate first,
                      // then live changes, with no missed or duplicated events
\`\`\`

Prefer rendering from subscription events over polling or re-fetching
after writes. With \`{ replay: true }\` you can render purely from
\`onCreate\`/\`onUpdate\`/\`onDelete\` without a separate initial \`list()\`.

For transient multiplayer/control-panel traffic, use ephemeral realtime
rooms. Room messages are not stored; they go to the other subscribers in
the room. Presence updates when visitors join, leave, or call
\`setPresence\`:

\`\`\`js
const room = spot.realtime.room('control');
room.on('cursor', ({ from, data }) => renderCursor(from.email, data));
room.onPresence((users) => renderOnline(users));
room.onStatus((status) => renderConnection(status)); // connecting/open/reconnecting/closed
room.setPresence({ role: 'operator' });
room.send('cursor', { x: 12, y: 8 });
\`\`\`

Rooms are private to this site except \`shared-*\` rooms, which are
global across Spot sites. Use rooms for cursors, player movement,
operator presence, live controls, and other state that should not be
persisted to the database.

### AI: text and image generation

Call AI from the browser — the OpenAI-compatible gateway key lives on the
server. By default this is limited to the site owner or platform admins;
authorized visitors can use it only when the deployment sets
SPOT_AI_ACCESS=visitors or the site opts in with \`"ai":"visitors"\` in
\`_access.json\`.

\`\`\`js
const res = await spot.ai.chat([{ role: 'user', content: 'Summarize my tasks' }]);
// res = { text, model, stop_reason, usage }
// Optional second-level fields in the request: system, max_tokens.
// model is accepted only when the deployment allowlists it.

// Stream tokens as they arrive (same options as chat, plus onToken/signal):
const final = await spot.ai.stream(
  [{ role: 'user', content: 'Write a haiku' }],
  { onToken: (delta, text) => render(text) },
);
// final = { text, model, stop_reason, usage }

const art = await spot.ai.image('A tiny cyberpunk greenhouse at night');
// art = { provider, model, images: [{ b64, mime_type, data_url }] }
const img = new Image();
img.src = art.images[0].data_url;
document.body.append(img);

// Supports any /v1/images/generations model exposed by the gateway.
// Common models include OpenAI gpt-image-2 and Nano Banana 2 through
// the deployment's LiteLLM alias, such as gemini-3.1-flash-image-preview.
\`\`\`

### Slack notifications

Post Slack notifications through Spot's server-side bot token. By default this
is limited to the site owner or platform admins; authorized visitors can use it
only when the deployment sets SPOT_SLACK_ACCESS=visitors or the site opts in
with \`"slack":"visitors"\` in \`_access.json\`.

\`\`\`js
await spot.slack.send({
  channel: '#signups', // Slack channel name, channel ID, or user ID for a DM
  text: '*New signup* from the guestbook',
});

await spot.slack.send({
  channel: 'C0123',
  blocks: [{ type: 'section', text: { type: 'mrkdwn', text: '*Ready*' } }],
});
\`\`\`

Slack text uses Slack mrkdwn, not CommonMark; pass \`mrkdwn:false\` for literal
text. \`blocks\` are forwarded unchanged. Public external image URLs work in
Slack image blocks; Spot file URLs are private to the mesh and Slack cannot
fetch them.

### File uploads

\`\`\`js
const stored = await spot.files.upload(fileInput.files[0]);
// stored = { id, name, size, content_type, url } — content is immutable
// per upload (25 MB max). If this site is restricted, downloads are too.

const files = await spot.files.list();   // [{ id, name, size, url }, ...]
await spot.files.delete(stored);         // or spot.files.delete(id, name)
\`\`\`

### Site management (Spot root only)

\`\`\`js
const mine = await spot.sites.mine();
const publicSites = await spot.sites.public();
await spot.sites.delete('old-demo');
\`\`\`

These platform APIs work from the Spot root, not from site subdomains.

### Errors and rate limits

Per-visitor: database 25 req/s, realtime room sends 30 req/s, uploads
2 req/s, AI 1 request per 2s (burst 10), Slack 1 req/s (burst 5). A 429 means slow down — do
not hammer APIs in loops.

Every call rejects with a \`spot.SpotError\` carrying \`status\`, a coarse
\`code\` (\`rate_limited\`, \`forbidden\`, \`unauthorized\`, \`not_found\`,
\`conflict\`, \`bad_request\`, \`server\`, \`network\`, \`stream\`), and
\`retryAfter\` (seconds) on a 429. The SDK retries rate-limited and transient
failures automatically with backoff, so a brief 429 usually resolves without
code; tune or disable it with \`spot.configure({ retry })\` (true, false, or a
max-retry count) or a per-call \`{ retry }\` option.

When rendering stored documents, set text via textContent / DOM APIs —
never interpolate document data into innerHTML.

### Access control (optional)

Sites are open to everyone by default. To restrict a site, deploy an
\`_access.json\` at its root:

\`\`\`json
{ "allow": ["alice@corp.com", "team-payments"] }
\`\`\`

Entries with an @ match the visitor's email; all others match a mesh
group name. The file applies to the whole site including its database
API. It is an allowlist, not a secret — permitted visitors can read it.
Add \`"ai":"visitors"\` only when those permitted visitors should be
allowed to spend the deployment's server-side AI key.
Add \`"slack":"visitors"\` only when those permitted visitors should be
allowed to spend the deployment's server-side Slack bot token.
Add \`"download":false\` to opt out of source ZIP downloads while keeping
normal page access unchanged.

The first deploy of a site claims it. Later deploys, including changes
to \`_access.json\`, require the same owner identity or a platform admin.
EOF
}

write_skill() {
    target=$1

    if [ "$init_dry_run" = 1 ]; then
        echo "would write $target"
        return 0
    fi

    if [ -e "$target" ] && [ "$init_force" != 1 ]; then
        echo "skipped $target (exists; use --force)"
        return 0
    fi

    mkdir -p "${target%/*}"
    render_skill > "$target"
    echo "wrote $target"
}

init() {
    init_scope=
    selected_agents=
    explicit_agents=0
    all_agents=0
    init_yes=0
    init_force=0
    init_dry_run=0

    while [ $# -gt 0 ]; do
        case $1 in
            --agent)
                [ $# -gt 1 ] || { echo "error: --agent needs a value" >&2; exit 1; }
                explicit_agents=1
                add_agent_list "$2"
                shift 2
                ;;
            --agent=*)
                explicit_agents=1
                add_agent_list "${1#--agent=}"
                shift
                ;;
            --all-agents)
                all_agents=1
                shift
                ;;
            --scope)
                [ $# -gt 1 ] || { echo "error: --scope needs a value" >&2; exit 1; }
                validate_scope "$2"
                init_scope=$2
                shift 2
                ;;
            --scope=*)
                init_scope=${1#--scope=}
                validate_scope "$init_scope"
                shift
                ;;
            --yes|-y)
                init_yes=1
                shift
                ;;
            --force)
                init_force=1
                shift
                ;;
            --dry-run)
                init_dry_run=1
                shift
                ;;
            --help|-h)
                usage
                ;;
            *)
                echo "error: unknown init option '$1'" >&2
                exit 1
                ;;
        esac
    done

    if [ "$all_agents" = 1 ] && [ "$explicit_agents" = 1 ]; then
        echo "error: use either --agent or --all-agents, not both" >&2
        exit 1
    fi

    if [ -z "$init_scope" ]; then
        if [ "$init_yes" = 1 ] || ! [ -t 0 ]; then
            if is_project_dir; then init_scope=project; else init_scope=user; fi
        else
            prompt_scope
        fi
    fi

    if [ "$all_agents" = 1 ]; then
        selected_agents="claude codex pi"
    elif [ "$explicit_agents" != 1 ]; then
        if [ "$init_yes" = 1 ] || ! [ -t 0 ]; then
            default_agents
        else
            prompt_agents
        fi
    fi

    [ -n "$selected_agents" ] || { echo "error: no agents selected" >&2; exit 1; }

    if [ "$init_yes" != 1 ] && [ "$init_dry_run" != 1 ] && [ -t 0 ]; then
        confirm_write
    fi

    for agent in $selected_agents; do
        write_skill "$(skill_path "$agent" "$init_scope")"
    done
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
    deploy) deploy "$@" ;;
    show)   show "$@" ;;
    init)   init "$@" ;;
    update) update_cli "$@" ;;
    *)      usage ;;
esac
