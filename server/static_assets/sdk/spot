show_meta_json() {
    manifest=$1
    python3 - "$manifest" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    manifest = json.load(f)
print(json.dumps(manifest["meta"], separators=(",", ":")))
PY
}

show_manifest() {
    file=$1
    command -v python3 >/dev/null 2>&1 || {
        echo "error: python3 is required for Spot Show validation and builds" >&2
        return 1
    }
    python3 - "$file" <<'PY'
import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

path = Path(sys.argv[1])
try:
    with path.open(encoding="utf-8") as f:
        show = json.load(f)
except Exception as exc:
    print(f"error: could not parse {path}: {exc}", file=sys.stderr)
    sys.exit(1)

errors = []
warnings = []
assets = []
card_ids = set()
known_kinds = {"markdown", "mermaid", "diff", "terminal", "code", "json", "image", "html", "trace"}
text_fields = ("body", "text", "content")
id_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")

def err(where, message):
    errors.append(f"{path}: {where}: {message}")

def warn_unknown(obj, allowed, where):
    for key in obj:
        if key not in allowed:
            warnings.append(f"{path}: {where}.{key}: unknown field")

def optional_string(obj, key, where):
    if key in obj and obj[key] is not None and not isinstance(obj[key], str):
        err(f"{where}.{key}", "must be a string")

def text_body(block, where):
    for key in text_fields:
        if key in block:
            if not isinstance(block[key], str):
                err(f"{where}.{key}", "must be a string")
                return ""
            return block[key]
    return ""

if not isinstance(show, dict):
    err("$", "must be an object")
    show = {}

warn_unknown(show, {"title", "description", "summary", "updated_at", "cards"}, "$")

for key in ("title", "description", "summary", "updated_at"):
    optional_string(show, key, "$")

cards = show.get("cards", [])
if not isinstance(cards, list):
    err("cards", "must be an array")
    cards = []

for card_index, card in enumerate(cards):
    where = f"cards[{card_index}]"
    if not isinstance(card, dict):
        err(where, "must be an object")
        continue
    warn_unknown(card, {"id", "title", "summary", "description", "compact", "blocks"}, where)
    for key in ("title", "summary", "description"):
        optional_string(card, key, where)
    if "compact" in card and not isinstance(card["compact"], bool):
        err(f"{where}.compact", "must be a boolean")
    if "id" in card:
        card_id = card["id"]
        if not isinstance(card_id, str) or not id_re.fullmatch(card_id):
            err(f"{where}.id", "must match [A-Za-z0-9][A-Za-z0-9_-]{0,63}")
        elif card_id in card_ids:
            err(f"{where}.id", f"duplicate card id {card_id!r}")
        else:
            card_ids.add(card_id)
    blocks = card.get("blocks", [])
    if not isinstance(blocks, list):
        err(f"{where}.blocks", "must be an array")
        continue
    for block_index, block in enumerate(blocks):
        block_where = f"{where}.blocks[{block_index}]"
        if not isinstance(block, dict):
            err(block_where, "must be an object")
            continue
        warn_unknown(block, {"kind", "type", "title", "body", "text", "content", "language", "line_start", "layout", "cols", "value", "data", "src", "url", "alt", "caption", "steps"}, block_where)
        kind = block.get("kind", block.get("type", "markdown"))
        if not isinstance(kind, str):
            err(f"{block_where}.kind", "must be a string")
            continue
        kind = kind.lower()
        if kind not in known_kinds:
            err(f"{block_where}.kind", f"unsupported block kind {kind!r}")
            continue
        optional_string(block, "title", block_where)
        if kind in {"markdown", "mermaid", "diff", "terminal", "code", "html"}:
            text_body(block, block_where)
        if kind == "code":
            optional_string(block, "language", block_where)
            if "line_start" in block and (
                isinstance(block["line_start"], bool)
                or not isinstance(block["line_start"], int)
                or block["line_start"] < 1
            ):
                err(f"{block_where}.line_start", "must be a positive integer")
        if kind == "diff" and "layout" in block:
            layout = block["layout"]
            if not isinstance(layout, str) or layout not in ("unified", "split"):
                err(f"{block_where}.layout", "must be unified or split")
        if kind == "terminal" and "cols" in block and (
            isinstance(block["cols"], bool)
            or not isinstance(block["cols"], int)
            or not 20 <= block["cols"] <= 240
        ):
            err(f"{block_where}.cols", "must be an integer from 20 to 240")
        if kind == "image":
            src = block.get("src", block.get("url"))
            if not isinstance(src, str) or not src:
                err(f"{block_where}.src", "must be a non-empty string")
            else:
                optional_string(block, "alt", block_where)
                optional_string(block, "caption", block_where)
                parsed = urlsplit(src)
                if src.startswith("//") or parsed.scheme in {"http", "https", "data"} or src.startswith("/"):
                    pass
                elif parsed.scheme:
                    err(f"{block_where}.src", f"unsupported URL scheme {parsed.scheme!r}")
                elif parsed.query or parsed.fragment:
                    err(f"{block_where}.src", "local paths cannot contain a query or fragment")
                else:
                    source = (path.parent / src).resolve()
                    root = path.parent.resolve()
                    try:
                        source.relative_to(root)
                    except ValueError:
                        err(f"{block_where}.src", f"local path escapes the Show directory: {src}")
                    else:
                        if not source.is_file():
                            err(f"{block_where}.src", f"local file not found: {src}")
                        else:
                            assets.append({"source": str(source), "relative": str(Path(src))})
        if kind == "trace":
            steps = block.get("steps")
            if not isinstance(steps, list) or not steps:
                err(f"{block_where}.steps", "must be a non-empty array")
                continue
            for step_index, step in enumerate(steps):
                step_where = f"{block_where}.steps[{step_index}]"
                if not isinstance(step, dict):
                    err(step_where, "must be an object")
                    continue
                warn_unknown(step, {"label", "kind", "status", "detail", "ts"}, step_where)
                if not isinstance(step.get("label"), str) or not step["label"]:
                    err(f"{step_where}.label", "must be a non-empty string")
                for key in ("kind", "detail", "ts"):
                    optional_string(step, key, step_where)
                if "status" in step:
                    status = step["status"]
                    if not isinstance(status, str) or status not in ("pending", "running", "done", "error"):
                        err(f"{step_where}.status", "must be pending, running, done, or error")

if errors:
    for message in errors:
        print(f"error: {message}", file=sys.stderr)
    sys.exit(1)

for message in warnings:
    print(f"warning: {message}", file=sys.stderr)

title = show.get("title") or "Spot Show"
description = show.get("description") or "A card/block visual report rendered by Spot."
print(json.dumps({
    "meta": {
        "title": title,
        "description": description,
        "tags": ["spot-show", "agent", "dashboard", "tools"],
    },
    "assets": assets,
}, separators=(",", ":")))
PY
}

show_copy_assets() {
    manifest=$1
    out=$2
    python3 - "$manifest" "$out" <<'PY'
import json
import shutil
import sys
from pathlib import Path

with open(sys.argv[1], encoding="utf-8") as f:
    manifest = json.load(f)
out = Path(sys.argv[2])
for asset in manifest["assets"]:
    target = out / asset["relative"]
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(asset["source"], target)
PY
}

show_validate() {
    spec=${1:-show.json}
    [ $# -le 1 ] || show_usage
    [ -f "$spec" ] || { echo "error: $spec not found" >&2; exit 1; }
    manifest=$(mktemp "${TMPDIR:-/tmp}/spot-show-manifest.XXXXXX")
    if ! show_manifest "$spec" > "$manifest"; then
        rm -f "$manifest"
        return 1
    fi
    rm -f "$manifest"
    echo "valid: $spec"
}

show_build() {
    spec=${1:-show.json}
    out=${2:-spot-show-out}
    [ -f "$spec" ] || { echo "error: $spec not found" >&2; exit 1; }
    case $out in
        ''|/|.) echo "error: refusing to write show output to '$out'" >&2; exit 1 ;;
    esac
    spec_dir=$(cd "$(dirname "$spec")" && pwd -P) || exit 1
    spec_abs=$spec_dir/$(basename "$spec")
    if [ -e "$out" ]; then
        if [ -d "$out" ]; then
            out_abs=$(cd "$out" && pwd -P) || exit 1
            case $spec_abs in
                "$out_abs"/*) echo "error: refusing to write show output over source '$spec'" >&2; exit 1 ;;
            esac
        else
            out_dir=$(cd "$(dirname "$out")" && pwd -P) || exit 1
            out_abs=$out_dir/$(basename "$out")
            [ "$out_abs" != "$spec_abs" ] || { echo "error: refusing to write show output over source '$spec'" >&2; exit 1; }
        fi
    fi
    manifest=$(mktemp "${TMPDIR:-/tmp}/spot-show-manifest.XXXXXX")
    if ! show_manifest "$spec" > "$manifest"; then
        rm -f "$manifest"
        return 1
    fi
    rm -rf "$out" || { rm -f "$manifest"; exit 1; }
    mkdir -p "$out" || exit 1
    cp "$spec" "$out/show.json" || exit 1
    if ! show_meta_json "$manifest" > "$out/_spot.json"; then
        rm -f "$manifest"
        exit 1
    fi
    if ! show_copy_assets "$manifest" "$out"; then
        rm -f "$manifest"
        exit 1
    fi
    rm -f "$manifest"
    cat > "$out/index.html" <<'EOF'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Spot Show</title>
  <style>
    :root {
      color-scheme:light;
      --bg:#f3f1eb; --panel:#fffefa; --panel2:#eeece5; --line:#c9c5ba;
      --text:#18201f; --muted:#5e6865; --dim:#7c8581; --accent:#08786e;
      --accent2:#235f91; --good:#087a52; --bad:#b83b3b; --warn:#9a6418;
      --shadow:0 1px 0 rgba(24,32,31,.06),0 12px 34px rgba(24,32,31,.045);
